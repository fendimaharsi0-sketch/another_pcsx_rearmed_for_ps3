/* Hardware renderer fragment programs.
 * Compiled once per variant: -DMODE=0 flat colour, 1 4-bit CLUT, 2 8-bit CLUT,
 * 3 15-bit direct, 4 plain VRAM copy, 5 self copy (the pixel's own colour with
 * bit 15 set: the fix-up for blended draws, see hwr_rsx.c); -DTWIN=1 adds the PS1
 * texture window; -DMCHK=1 the mask check: pixels whose bit 15 is set in the
 * native VRAM are not drawn (uv.zw = the native position).
 * -DFILT=1 (textured modes 1..3 only, prototype): bilinear texture filtering.
 * -DPERF=1 (mode 3 only, fast path only): "Bilinear (Performance)" — the RSX
 * texture unit does the bilinear interpolation (hardware LINEAR) for 15-bit
 * direct textures, 1 fetch instead of the manual 4 taps. The backend selects
 * a PERF program only for mode 3 in the upscaled pass; CLUT modes 1/2 in
 * Performance mode still use the manual FILT programs (hardware LINEAR would
 * interpolate CLUT indexes, not colours), and the byte-decoding fallback also
 * stays manual. Tradeoffs vs manual bilinear, accepted for the performance
 * name: the interpolated bit-15/STP is a plain average, not a majority vote,
 * so transparent/STP edges are softer, and a texture-window edge can blend
 * with the neighbouring tile instead of wrapping (the window is applied to
 * the integer part only, the fraction carries across it).
 * The backend (hwr_rsx.c) selects a FILT/PERF program only for the upscaled
 * pass; the native pass, the self-test, flat/copy/self programs and the
 * byte-decoding fallback when the fast programs fail all stay nearest, so
 * native VRAM is never blurred. Filtering is bilinear only (4 taps):
 * JINC2/xBR are deliberately not implemented for the RSX.
 *
 * Bilinear rules, shared by both paths (SwanStation's FilteredSampleFromVRAM
 * pattern, reimplemented for this VRAM layout):
 *  - taps are the 4 texels around the pixel's texel centre (uv - 0.5), each
 *    clamped to the primitive's texel range (lim) and then texture-windowed,
 *    so edges never bleed into a neighbouring tile;
 *  - a tap whose texel is transparent (0000) contributes no colour and no
 *    weight: the remaining weights are renormalised, so a transparent black
 *    texel never darkens an edge (SwanStation's rgb /= ialpha compensation);
 *  - the STP (bit 15) output is the same weighted average, so the existing
 *    pass drop test (threshold 0.5) becomes a majority vote for the STP pass.
 *
 * All maths is float, but the RSX evaluates parts of it at half precision (11-bit
 * mantissa: a 15-bit colour value loses its red bits). So a VRAM halfword is kept
 * as its two bytes and every intermediate stays an integer below 2048. */
#ifndef MODE
#define MODE 0
#endif
#ifndef TWIN
#define TWIN 0
#endif
#ifndef FAST
#define FAST 0
#endif
#ifndef MCHK
#define MCHK 0
#endif
#ifndef FILT
#define FILT 0
#endif
#ifndef PERF
#define PERF 0
#endif

float wrapf(float a, float m) { return a - m * floor(a / m); }

/* VRAM is viewed as a 512x512 A8R8G8B8 texture: each texel holds four VRAM bytes,
   memory byte 0 in A, 1 in R, 2 in G, 3 in B (checked on the console by the
   self-test; the host test uploads to match). 512 is a power of two, so REPEAT
   addressing wraps coordinates at the VRAM edges like the PS1 does. VRAM
   halfwords are big-endian here (the RSX 15-bit surface layout): high byte first,
   so PS1 byte n is memory byte n ^ 1. */
float4 fetch(sampler2D vram, float tx, float y)
{
    return tex2D(vram, (float2(tx, y) + 0.5f) * (1.0f / 512.0f));
}

/* one byte; bx = byte column 0..2047 */
float rd8(sampler2D vram, float bx, float y)
{
    float q = floor(bx * 0.25f), k = bx - 4.0f * q;
    float4 t = fetch(vram, q, y);
    /* PS1 byte k of the texel is memory byte k ^ 1: k 0 -> R, 1 -> A, 2 -> B, 3 -> G */
    float4 m = float4(k == 0.0f ? 1.0f : 0.0f, k == 3.0f ? 1.0f : 0.0f, k == 2.0f ? 1.0f : 0.0f, k == 1.0f ? 1.0f : 0.0f);
    return floor(dot(t, m) * 255.0f + 0.5f);
}

/* one halfword as (low byte, high byte); hx = halfword column */
float2 rd16(sampler2D vram, float hx, float y)
{
    float q = floor(hx * 0.5f), odd = hx - 2.0f * q;
    float4 t = fetch(vram, q, y);
    float lo = lerp(t.x, t.z, odd), hi = lerp(t.w, t.y, odd);
    return floor(float2(lo, hi) * 255.0f + 0.5f);
}

/* 5-bit r, g, b from the two bytes of a BGR555 halfword */
float3 rgb15(float2 c)
{
    float l5 = floor(c.x * (1.0f / 32.0f)), h4 = floor(c.y * 0.25f);
    return float3(c.x - 32.0f * l5, l5 + 8.0f * (c.y - 4.0f * h4), h4 - 32.0f * floor(h4 * (1.0f / 32.0f)));
}

#if TWIN
float bitf(float v, float b) { return wrapf(floor(v / b), 2.0f); }
/* texel bits 3..7 selected by the mask come from the offset (offset is pre-masked) */
float twin(float t, float m, float o)
{
    float r = t;
    r += bitf(m, 1.0f)  * (bitf(o, 1.0f)  - bitf(t, 8.0f))   * 8.0f;
    r += bitf(m, 2.0f)  * (bitf(o, 2.0f)  - bitf(t, 16.0f))  * 16.0f;
    r += bitf(m, 4.0f)  * (bitf(o, 4.0f)  - bitf(t, 32.0f))  * 32.0f;
    r += bitf(m, 8.0f)  * (bitf(o, 8.0f)  - bitf(t, 64.0f))  * 64.0f;
    r += bitf(m, 16.0f) * (bitf(o, 16.0f) - bitf(t, 128.0f)) * 128.0f;
    return r;
}
#endif

#if FILT
/* Single-texel fetchers used only by the bilinear path below. They repeat the
 * nearest fetch of main() verbatim for one integer texel w / (u, v), so the
 * filtered result is exactly the average of the texels nearest would pick. */
half4 texel_fast(sampler2D vram16, sampler2D vram8, float4 t1, float2 w)
{
#if MODE == 1
    float hu = floor(w.x * 0.5f), m = w.x - 2.0f * hu, m2 = hu - 2.0f * floor(hu * 0.5f);
    float b = floor(tex2D(vram8, float2(t1.x * 2.0f + hu - 2.0f * m2 + 0.5f, t1.y + w.y) *
                                 float2(1.0f / 2048.0f, 1.0f / 512.0f)).x * 255.0f + 0.5f);
    float hiN = floor(b * (1.0f / 16.0f));
    return h4tex2D(vram16, float2(t1.z + lerp(b - 16.0f * hiN, hiN, m), t1.w) * float2(1.0f / 1024.0f, 1.0f / 512.0f));
#elif MODE == 2
    float m2 = w.x - 2.0f * floor(w.x * 0.5f);
    float b = floor(tex2D(vram8, float2(t1.x * 2.0f + w.x - 2.0f * m2 + 0.5f, t1.y + w.y) *
                                 float2(1.0f / 2048.0f, 1.0f / 512.0f)).x * 255.0f + 0.5f);
    return h4tex2D(vram16, float2(t1.z + b, t1.w) * float2(1.0f / 1024.0f, 1.0f / 512.0f));
#elif MODE == 3
    return h4tex2D(vram16, (t1.xy + w) * float2(1.0f / 1024.0f, 1.0f / 512.0f));
#else
    return half4(0.0h, 0.0h, 0.0h, 0.0h);
#endif
}

float2 texel_slow(sampler2D vram, float4 t1, float u, float v)
{
    float tpx = floor(t1.x + 0.5f);
    float y = floor(t1.y + 0.5f) + v;
#if MODE == 1
    float b = rd8(vram, tpx * 2.0f + floor(u * 0.5f), y);
    float hiN = floor(b * (1.0f / 16.0f));
    float idx = lerp(b - 16.0f * hiN, hiN, u - 2.0f * floor(u * 0.5f));
    return rd16(vram, floor(t1.z + 0.5f) + idx, floor(t1.w + 0.5f));
#elif MODE == 2
    float b = rd8(vram, tpx * 2.0f + u, y);
    return rd16(vram, floor(t1.z + 0.5f) + b, floor(t1.w + 0.5f));
#elif MODE == 3
    return rd16(vram, tpx + u, y);
#else
    return float2(0.0f, 0.0f);
#endif
}
#endif

#if FAST
/* Fast variants: the texture unit decodes VRAM. vram16 views it as a 1024x512
   A1R5G5B5 texture (one fetch = a halfword's 5-bit colours, already scaled, and
   its bit 15 in alpha; red = PS1 blue, as the target wants), vram8 as a 2048x512
   8-bit texture (CLUT indexes; PS1 byte n is memory byte n ^ 1). Per-primitive
   values that only end up in texture coordinates (texture page, CLUT position)
   are used unrounded: a small interpolation error stays inside the texel. The
   byte-decoding programs below stay as the fallback if the start-up self-test
   rejects these. */
/* Inputs prepared by the fast vertex program (hwr.vcg with FAST): col = the
   colour already scaled for this mode (PS1 red in .b) and bit 15 in .a; t1 = page
   and CLUT positions + 0.5; t3.z/.w = pass weights: drop = w2 + bit15 * (w1 - w2). */
half4 main(float4 uv : TEXCOORD0, float4 col : TEXCOORD1, float4 t1 : TEXCOORD2,
           float4 t2 : TEXCOORD3, float4 t3 : TEXCOORD4, float4 lim : TEXCOORD5,
           float4 pgx : TEXCOORD6,   /* PGXP slice 1: u/w, v/w, 1/w (identity when off) */
           uniform sampler2D vram16, uniform sampler2D vram8) : COLOR
{
    /* PGXP slice 1: perspective-correct UV. The vertex program passed u/w, v/w
       and 1/w; dividing per pixel restores true u, v. Identity when PGXP is
       off or the triangle did not validate (pgx = u, v, 1). uv.zw (native
       position, used by the mask check / self copy below) is untouched. The
       divide stays in float: the RSX evaluates parts of fragment math at
       half precision (see the header note), and 1/w needs the full range. */
    uv.xy = pgx.xy * (1.0f / pgx.z) + 1.0e-4f;
    /* +1e-4: the affine path biases UVs by 1/256 texel at the vertices so exact
       integers do not floor down a texel (see ps1_sample_shift); the float
       division above can land a hair below an integer, so this keeps the
       same edge. Far below a texel, so sampling is unchanged elsewhere. */
#if MCHK
    if (h4tex2D(vram16, (floor(uv.zw) + 0.5f) * float2(1.0f / 1024.0f, 1.0f / 512.0f)).a > 0.5h) discard;
#endif
#if MODE == 0
    /* native VRAM (t2.x = 1): the PS1 keeps the top 5 bits of each 8-bit colour (the
       RSX would round to the nearest 5-bit value: 1-2 steps brighter fog, fades that
       never finish). The upscaled picture keeps all 8 bits: rounded there, the fog's
       gradients turned into coloured bands */
    return half4(lerp(col.rgb, floor(col.rgb * (255.0f / 8.0f) + (1.0f / 64.0f)) * (1.0f / 31.0f), t2.x), col.a);
#elif MODE == 5
    return half4(h4tex2D(vram16, (floor(uv.zw) + 0.5f) * float2(1.0f / 1024.0f, 1.0f / 512.0f)).rgb, 1.0h);
#elif MODE == 4
    return h4tex2D(vram16, (floor(uv.xy) + 0.5f) * float2(1.0f / 1024.0f, 1.0f / 512.0f));
#else
    half4 t;
#if PERF
    /* Hardware bilinear, mode 3 only: t1.xy already carries the +0.5 texel
       centre, so (t1.xy + p) with a fractional p lands between texel centres
       and the texture unit (LINEAR, set by the backend) interpolates them.
       The window is applied to the integer part only; the final clamp to lim
       keeps the sample from blending past the primitive's texel range. The
       common code below (transparent drop, modulation) runs unchanged. */
    float2 p = uv.xy - 256.0f * floor(uv.xy * (1.0f / 256.0f));
    float2 ip = clamp(floor(p), lim.xy, lim.zw);
#if TWIN
    ip.x = twin(ip.x, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    ip.y = twin(ip.y, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
    p = ip + (p - floor(p));
#else
    p = clamp(ip + (p - floor(p)), lim.xy, lim.zw);
#endif
    t = h4tex2D(vram16, (t1.xy + p) * float2(1.0f / 1024.0f, 1.0f / 512.0f));
#elif FILT
    /* Bilinear: the 4 texels around the texel centre (uv - 0.5). Each tap is
       clamped to lim, then windowed, exactly as the nearest fetch is. */
    float2 pc = uv.xy - 256.0f * floor(uv.xy * (1.0f / 256.0f));
    float2 base = floor(pc - 0.5f);
    float2 fr = pc - 0.5f - base;
    float2 t00 = clamp(base, lim.xy, lim.zw);
    float2 t10 = clamp(base + float2(1.0f, 0.0f), lim.xy, lim.zw);
    float2 t01 = clamp(base + float2(0.0f, 1.0f), lim.xy, lim.zw);
    float2 t11 = clamp(base + float2(1.0f, 1.0f), lim.xy, lim.zw);
#if TWIN
    t00.x = twin(t00.x, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    t00.y = twin(t00.y, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
    t10.x = twin(t10.x, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    t10.y = twin(t10.y, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
    t01.x = twin(t01.x, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    t01.y = twin(t01.y, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
    t11.x = twin(t11.x, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    t11.y = twin(t11.y, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
#endif
    half4 s00 = texel_fast(vram16, vram8, t1, t00);
    half4 s10 = texel_fast(vram16, vram8, t1, t10);
    half4 s01 = texel_fast(vram16, vram8, t1, t01);
    half4 s11 = texel_fast(vram16, vram8, t1, t11);
    float a00 = dot(float4(s00), float4(1.0f, 1.0f, 1.0f, 1.0f)) == 0.0f ? 0.0f : 1.0f;
    float a10 = dot(float4(s10), float4(1.0f, 1.0f, 1.0f, 1.0f)) == 0.0f ? 0.0f : 1.0f;
    float a01 = dot(float4(s01), float4(1.0f, 1.0f, 1.0f, 1.0f)) == 0.0f ? 0.0f : 1.0f;
    float a11 = dot(float4(s11), float4(1.0f, 1.0f, 1.0f, 1.0f)) == 0.0f ? 0.0f : 1.0f;
    float w00 = (1.0f - fr.x) * (1.0f - fr.y);
    float w10 = fr.x * (1.0f - fr.y);
    float w01 = (1.0f - fr.x) * fr.y;
    float w11 = fr.x * fr.y;
    float ialpha = w00 * a00 + w10 * a10 + w01 * a01 + w11 * a11;
    if (ialpha > 0.0f)
        t = half4((w00 * a00 * s00.rgb + w10 * a10 * s10.rgb + w01 * a01 * s01.rgb + w11 * a11 * s11.rgb) / ialpha,
                  (w00 * a00 * s00.a + w10 * a10 * s10.a + w01 * a01 * s01.a + w11 * a11 * s11.a) / ialpha);
    else
        t = half4(0.0h, 0.0h, 0.0h, 0.0h);
#else
    float2 w = floor(uv.xy);
    w = floor(clamp(w - 256.0f * floor(w * (1.0f / 256.0f)), lim.xy, lim.zw) + 0.5f);
#if TWIN
    w.x = twin(w.x, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    w.y = twin(w.y, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
#endif
#if MODE == 1
    float hu = floor(w.x * 0.5f), m = w.x - 2.0f * hu, m2 = hu - 2.0f * floor(hu * 0.5f);
    /* PS1 byte tpx*2 + hu is memory byte ^ 1 = tpx*2 + hu + 1 - 2*(hu & 1); the +1
       comes from t1.x's +0.5 doubled, the +0.5 is the texel centre */
    float b = floor(tex2D(vram8, float2(t1.x * 2.0f + hu - 2.0f * m2 + 0.5f, t1.y + w.y) *
                                 float2(1.0f / 2048.0f, 1.0f / 512.0f)).x * 255.0f + 0.5f);
    float hiN = floor(b * (1.0f / 16.0f));
    t = h4tex2D(vram16, float2(t1.z + lerp(b - 16.0f * hiN, hiN, m), t1.w) * float2(1.0f / 1024.0f, 1.0f / 512.0f));
#elif MODE == 2
    float m2 = w.x - 2.0f * floor(w.x * 0.5f);
    float b = floor(tex2D(vram8, float2(t1.x * 2.0f + w.x - 2.0f * m2 + 0.5f, t1.y + w.y) *
                                 float2(1.0f / 2048.0f, 1.0f / 512.0f)).x * 255.0f + 0.5f);
    t = h4tex2D(vram16, float2(t1.z + b, t1.w) * float2(1.0f / 1024.0f, 1.0f / 512.0f));
#else
    t = h4tex2D(vram16, (t1.xy + w) * float2(1.0f / 1024.0f, 1.0f / 512.0f));
#endif
#endif
    /* never the transparent 0000 texel, and only this pass's texels */
    if ((dot(t, half4(1.0h, 1.0h, 1.0h, 1.0h)) == 0.0h ? 1.0h : 0.0h) + (half)t3.z + t.a * (half)t3.w > 0.5h) discard;
    /* modulation: 5-bit texel * vertex colour / 128, rounded down like the PS1 (raw
       textures have colour 128); in float: the product reaches 7905 */
    float3 c5 = floor((float3)t.rgb * 31.0f + 0.5f), c8 = floor(col.rgb * 128.0f + (1.0f / 64.0f));
    float3 mo = c5 * c8 * (1.0f / 128.0f);        /* t2.x: native VRAM rounds down (see MODE 0) */
    return half4(min(lerp(mo, floor(mo), t2.x), 31.0f) * (1.0f / 31.0f), max(t.a, (half)col.a));
#endif
}
#else
float4 main(float4 uv : TEXCOORD0, float4 col : TEXCOORD1, float4 t1 : TEXCOORD2,
            float4 t2 : TEXCOORD3, float4 t3 : TEXCOORD4, float4 lim : TEXCOORD5,
            float4 pgx : TEXCOORD6,   /* PGXP slice 1: see the fast main above */
            uniform sampler2D vram) : COLOR
{
    uv.xy = pgx.xy * (1.0f / pgx.z) + 1.0e-4f;   /* PGXP slice 1: perspective-correct UV (identity when off; +1e-4 edge bias, see the fast main) */
#if MCHK
    if (rd16(vram, floor(uv.z), floor(uv.w)).y > 127.5f) discard;
#endif
    /* alpha = the pixel's bit 15: the mask-set flag (col.a), or the texel's STP bit */
#if MODE == 0
    /* red and blue swapped (see hwr.h); native VRAM (t2.x = 1): the top 5 bits of each
       colour, like the PS1; the upscaled picture all 8 */
    return float4(lerp(col.bgr * (1.0f / 255.0f), floor(col.bgr * (1.0f / 8.0f) + (1.0f / 64.0f)) * (1.0f / 31.0f), t2.x), col.a);
#elif MODE == 5
    return float4(rgb15(rd16(vram, floor(uv.z), floor(uv.w))).zyx * (1.0f / 31.0f), 1.0f);
#elif MODE == 4
    float2 c = rd16(vram, floor(uv.x), floor(uv.y));
    /* alpha: bit 15; one final multiply (cgcomp hazard: nothing may be computed
       after the colour output is written, see tools/fpcheck.py) */
    return float4(rgb15(c).zyx, floor(c.y * (1.0f / 128.0f)) * 31.0f) * (1.0f / 31.0f);
#else
#if FILT
    /* Bilinear, byte-decoding path: same 4-tap rule as the fast path, with the
       halfword (not the decoded colour) as the tap value, so CLUT indexes are
       never interpolated. Returns directly; the nearest code below is skipped. */
    float pu = wrapf(uv.x, 256.0f), pv = wrapf(uv.y, 256.0f);
    float bu = floor(pu - 0.5f), bv = floor(pv - 0.5f);
    float fu = pu - 0.5f - bu, fv = pv - 0.5f - bv;
    float2 tap00 = float2(bu, bv), tap10 = float2(bu + 1.0f, bv);
    float2 tap01 = float2(bu, bv + 1.0f), tap11 = float2(bu + 1.0f, bv + 1.0f);
    tap00 = clamp(tap00, float2(floor(lim.x + 0.5f), floor(lim.y + 0.5f)), float2(floor(lim.z + 0.5f), floor(lim.w + 0.5f)));
    tap10 = clamp(tap10, float2(floor(lim.x + 0.5f), floor(lim.y + 0.5f)), float2(floor(lim.z + 0.5f), floor(lim.w + 0.5f)));
    tap01 = clamp(tap01, float2(floor(lim.x + 0.5f), floor(lim.y + 0.5f)), float2(floor(lim.z + 0.5f), floor(lim.w + 0.5f)));
    tap11 = clamp(tap11, float2(floor(lim.x + 0.5f), floor(lim.y + 0.5f)), float2(floor(lim.z + 0.5f), floor(lim.w + 0.5f)));
#if TWIN
    tap00.x = twin(tap00.x, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    tap00.y = twin(tap00.y, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
    tap10.x = twin(tap10.x, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    tap10.y = twin(tap10.y, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
    tap01.x = twin(tap01.x, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    tap01.y = twin(tap01.y, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
    tap11.x = twin(tap11.x, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    tap11.y = twin(tap11.y, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
#endif
    float2 c00 = texel_slow(vram, t1, tap00.x, tap00.y);
    float2 c10 = texel_slow(vram, t1, tap10.x, tap10.y);
    float2 c01 = texel_slow(vram, t1, tap01.x, tap01.y);
    float2 c11 = texel_slow(vram, t1, tap11.x, tap11.y);
    float a00 = (c00.x + c00.y < 0.5f) ? 0.0f : 1.0f;
    float a10 = (c10.x + c10.y < 0.5f) ? 0.0f : 1.0f;
    float a01 = (c01.x + c01.y < 0.5f) ? 0.0f : 1.0f;
    float a11 = (c11.x + c11.y < 0.5f) ? 0.0f : 1.0f;
    float fw00 = (1.0f - fu) * (1.0f - fv);
    float fw10 = fu * (1.0f - fv);
    float fw01 = (1.0f - fu) * fv;
    float fw11 = fu * fv;
    float fialpha = fw00 * a00 + fw10 * a10 + fw01 * a01 + fw11 * a11;
    if (fialpha < 0.5f / 256.0f) discard;
    float3 ftx = (fw00 * a00 * rgb15(c00) + fw10 * a10 * rgb15(c10) + fw01 * a01 * rgb15(c01) + fw11 * a11 * rgb15(c11)) / fialpha;
    float fstp = (fw00 * a00 * floor(c00.y * (1.0f / 128.0f)) + fw10 * a10 * floor(c10.y * (1.0f / 128.0f)) +
                  fw01 * a01 * floor(c01.y * (1.0f / 128.0f)) + fw11 * a11 * floor(c11.y * (1.0f / 128.0f))) / fialpha;
    float fps = floor(t3.z + 0.5f);
    float fdrop = (fps == 1.0f ? fstp : 0.0f) + (fps == 2.0f ? 1.0f - fstp : 0.0f);
    if (fdrop > 0.5f) discard;
    float3 fmo = ftx * floor(col.rgb + (1.0f / 64.0f)) * (1.0f / 128.0f);
    float3 fo = lerp(min(lerp(fmo, floor(fmo), t2.x), float3(31.0f, 31.0f, 31.0f)), ftx, t2.y);
    return float4(fo.zyx * (1.0f / 31.0f), max(fstp, col.a));
#else
    float u = wrapf(floor(uv.x), 256.0f), v = wrapf(floor(uv.y), 256.0f);
    /* stay inside the texels the primitive maps: at higher resolutions edge pixels
       would otherwise pick a neighbouring texel and show seams between polygons */
    u = clamp(u, floor(lim.x + 0.5f), floor(lim.z + 0.5f));
    v = clamp(v, floor(lim.y + 0.5f), floor(lim.w + 0.5f));
#if TWIN
    u = twin(u, floor(t2.z + 0.5f), floor(t3.x + 0.5f));
    v = twin(v, floor(t2.w + 0.5f), floor(t3.y + 0.5f));
#endif
    float tpx = floor(t1.x + 0.5f);
    float y = floor(t1.y + 0.5f) + v;
    float2 c;
#if MODE == 1
    float b = rd8(vram, tpx * 2.0f + floor(u * 0.5f), y);
    float hiN = floor(b * (1.0f / 16.0f));
    float idx = lerp(b - 16.0f * hiN, hiN, u - 2.0f * floor(u * 0.5f));
    c = rd16(vram, floor(t1.z + 0.5f) + idx, floor(t1.w + 0.5f));
#elif MODE == 2
    float b = rd8(vram, tpx * 2.0f + u, y);
    c = rd16(vram, floor(t1.z + 0.5f) + b, floor(t1.w + 0.5f));
#else
    c = rd16(vram, tpx + u, y);
#endif
    float stp = floor(c.y * (1.0f / 128.0f));
    /* t3.z: 0 draw all texels, 1 only STP=0 texels, 2 only STP=1 texels.
       keep = 1 when the texel belongs to this pass and is not the transparent 0x0000 */
    float ps = floor(t3.z + 0.5f);
    float drop = (c.x + c.y < 0.5f ? 1.0f : 0.0f) + (ps == 1.0f ? stp : 0.0f) + (ps == 2.0f ? 1.0f - stp : 0.0f);
    if (drop > 0.5f) discard;
    float3 tx = rgb15(c);
    /* modulation texel * colour / 128, rounded down like the PS1 in native VRAM (t2.x) */
    float3 mo = tx * floor(col.rgb + (1.0f / 64.0f)) * (1.0f / 128.0f);
    float3 o = lerp(min(lerp(mo, floor(mo), t2.x), float3(31.0f, 31.0f, 31.0f)), tx, t2.y);
    return float4(o.zyx * (1.0f / 31.0f), max(stp, col.a));
#endif
#endif
}
#endif
