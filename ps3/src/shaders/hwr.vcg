#ifndef FAST
#define FAST 0
#endif

/* Hardware renderer vertex program: PS1 VRAM coordinates -> clip space.
 * The render target covers all of VRAM (1024x512 native pixels, upscaled). */
void main(float4 pos : POSITION,   /* x, y, u, v */
          float4 col : TEXCOORD0,  /* r, g, b (0..255), depth */
          float4 t1  : TEXCOORD1,  /* texpage x, texpage y, clut x, clut y */
          float4 t2  : TEXCOORD2,  /* mode, raw, window mask x, window mask y */
          float4 t3  : TEXCOORD3,  /* window offset x, window offset y, pass, mask-set flag */
          float4 lim : TEXCOORD4,  /* umin, vmin, umax, vmax */
          uniform float native,    /* 1 in the native VRAM pass: colours rounded like the PS1 */
          out float4 oPos : POSITION,
          out float4 oUv  : TEXCOORD0,
          out float4 oCol : TEXCOORD1,
          out float4 oT1  : TEXCOORD2,
          out float4 oT2  : TEXCOORD3,
          out float4 oT3  : TEXCOORD4,
          out float4 oLim : TEXCOORD5)
{
    /* depth orders the primitives of one op in the native pass (see hwr_rsx.c) */
    oPos = float4(pos.x * (1.0f / 512.0f) - 1.0f, 1.0f - pos.y * (1.0f / 256.0f), col.w, 1.0f);
    /* .zw: the native VRAM position, for the programs that read the pixel they
       draw over (mask check, bit-15 self copy) */
    oUv = float4(pos.z, pos.w, pos.x, pos.y);
#if FAST
    /* work the fragment programs would repeat per pixel: colour scaled for the mode
       (flat: /255, textured: /128) with PS1 red moved to .b, texel centres, and the
       pass as weights (drop = w2 + bit15 * (w1 - w2)) */
    float ps = floor(t3.z + 0.5f), w1 = ps == 1.0f ? 1.0f : 0.0f, w2 = ps == 2.0f ? 1.0f : 0.0f;
    oCol = float4(col.bgr * (t2.x < 0.5f ? 1.0f / 255.0f : 1.0f / 128.0f), t3.w);
    oT1 = t1 + 0.5f;
    oT2 = float4(native, t2.yzw);   /* .x: round colours to 5 bits like the PS1 */
    oT3 = float4(t3.x, t3.y, w2, w1 - w2);
#else
    oCol = float4(col.rgb, t3.w);
    oT1 = t1;
    oT2 = float4(native, t2.yzw);   /* .x: round colours to 5 bits like the PS1 */
    oT3 = float4(t3.xyz, 0.0f);
#endif
    oLim = lim;
}
