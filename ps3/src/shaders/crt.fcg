/* DIAGNOSTIC (temporary, REVERT after the test): all 25 uniforms
   hardcoded to their defaults as consts, so no Set call is needed.
   If the picture renders (non-black), the shader + binding + drawing
   are proven fine and the Set path alone is the failure; if still
   black, the problem is NOT Set. ---
   Port to the PCSX-ReARMed PS3 fork's final pass (video.c): single-pass
   fragment program (fp40), compiled by build.sh into shaders.h.
   Base: CRT-Hybrid-Lottes-Fast curved v3.4.2 (PS3 .cg, below).
   Adaptations (see the body): the RetroArch input struct is gone — sizes
   and frame count arrive as uniforms set by video.c; the effect grid is
   the Magpie v4.13 virtual resolution gate (gateY: 240/480, X auto-aspect),
   so scanlines/mask stay at true CRT lines even when the RSX renders at
   2x-4x; bob is the Magpie v4.13 half-line raster shift (aesthetic).
   Interlace paint/decay is NOT ported. */
/*
    =============================================================================
    CRT-Lottes-Fast Ultimate for PS3 (Curved - Chroma Energy Gate v3.4.2)
    =============================================================================
    Adapted from Timothy Lottes' Shadertoy public domain CRT shader.
    Highly optimized and expanded specifically for the PS3 RSX GPU.

    CHANGELOG / VERSION HISTORY:
    - v1.0   : Initial PS3 Cg port, removed incompatible PC macros, simplified gamma.
    - v1.1   : Ultra-optimized 4-Tap Bilinear fetch & Branchless Mask for solid 60fps.
    - v1.2   : Expanded to 8 Mask Types (Added Delta Dot, Slot Mask, NEC CromaClear).
    - v1.3   : Integrated Dynamic Beam Dilation (Scanlines expand on bright pixels).
    - v1.4   : Decoupled Game Layer vs CRT Glass for Perfect Coherent Scaling/Zoom.
    - v1.5   : Added Spatio-Temporal NTSC Composite Color Bleed & Upward Dot Crawl.
    - v1.6   : Fixed Scanline Washout bug by stabilizing Tonemapper Auto-Exposure.
    - v1.7   : Capped Horizontal Blur max range to 0.5 to eliminate ghosting.
    - v1.8.1 : Fixed horz subpixel alignment, 4-tap bypass, and RSX vectorization.
    - v1.8.3 : Implemented Zero-Cost Edge Detection (only triggers on high-contrast edges).
    - v1.8.4 : Added DOT_SIZE parameter to scale and enlarge NTSC dot crawl width.
    - v1.9   : Implemented Method 1 (Selective Red/Blue Channel Bleed).
    - v2.0   : Added 1-MAD CRT White Point Temperature slider (D65, D93, D50).
    - v2.1   : Deep ALU & Register Optimization (CrtsMask vector compression).
    - v2.3   : Added DOT_REACH parameter to control pixel penetration of dot crawl.
    - v2.5   : Decoupled stationary X envelope to lock motion strictly upward.
    - v2.6   : Locked to True 3-Phase RGB Prism; purged redundant branch code.
    - v2.9   : Added CRAWL_SPEED slider parameter (0.0 to 2.0x) for custom pacing.
    - v3.0   : Collapsed 6x sin() dot-crawl phases to sin()+cos() via angle-sum identities.
    - v3.1   : Added zero-extra-tap Phosphor Bloom/Halation using existing 4-tap samples.
    - v3.2.1 : Fixed pow/max/bloom strict vector type-matching for PS3 cgc compiler.
    - v3.3   : Physical Signal Chain Alignment: NTSC Bleed & Dot Crawl fused into beam.
    - v3.4   : Upgraded to True NTSC Chroma Energy Gate (R-Y / B-Y quadrature energy).
    - v3.4.1 : Set default DOT_CRAWL to 0.30.
    - v3.4.2 : Bezel/corner AA now measured in physical output pixels (parity with
               Magpie v4.8 "High-Res Bezel AA"); pure uniform swap, zero extra ALU/taps.
               (fmod frame-count guard deliberately NOT backported: +1 ALU, PS3 at limit.)
    =============================================================================
*/

#pragma parameter CURVATURE "Curvature (Set 0 to flatten)" 0.02 0.0 0.25 0.01
#pragma parameter TRINITRON_CURVE "Trinitron-style Curve" 0.0 0.0 1.0 1.0
#pragma parameter CORNER "Corner Round (Set 0 for sharp)" 3.0 0.0 11.0 1.0
#pragma parameter MASK "Mask Type (0 to 7)" 4.0 0.0 7.0 1.0
#pragma parameter MASK_SIZE "CRT Scale / Density (0.1-4.0)" 1.0 0.1 4.0 0.05
#pragma parameter MASK_INTENSITY "Mask Intensity" 0.5 0.0 1.0 0.05
#pragma parameter SCANLINE_THINNESS "Scanline Intensity" 0.5 0.0 1.0 0.1
#pragma parameter BEAM_DILATION "Scanline Beam Dilation" 0.5 0.0 1.0 0.05
#pragma parameter SCAN_BLUR "Horizontal Blur" 0.20 0.0 0.5 0.05
#pragma parameter COLOR_BLEED "Color Bleed (-L / +R)" 0.0 -2.0 2.0 0.05
#pragma parameter DOT_CRAWL "NTSC Dot Crawl" 0.30 0.0 1.0 0.05
#pragma parameter CRAWL_SPEED "NTSC Crawl Speed" 0.75 0.0 2.0 0.05
#pragma parameter DOT_SIZE "NTSC Dot Size" 2.0 0.5 4.0 0.25
#pragma parameter DOT_REACH "NTSC Dot Reach (Spread)" 1.0 0.25 4.0 0.25
#pragma parameter COLOR_TEMP "Color Temp (-Warm / +Cool D93)" 0.0 -1.0 1.0 0.05
#pragma parameter VIBRANCY "Color Vibrancy (0=Neutral)" 0.10 -1.0 2.0 0.05
#pragma parameter BRIGHT_BOOST "Brightness Boost" 1.1 0.5 2.0 0.05
#pragma parameter BLOOM_AMOUNT "Phosphor Bloom / Halation" 0.25 0.0 1.0 0.05
#pragma parameter CRT_GAMMA "CRT Gamma Input" 2.4 0.1 5.0 0.1
#pragma parameter CRT_OUT_GAMMA "CRT Gamma Output" 2.2 0.1 5.0 0.1

/* Uniforms, set by video.c every frame from cfg (see crt_set_constants).
   The 20 effect parameters keep the .cg names so the lookup matches;
   gateY/bob come from Magpie v4.13 (virtual resolution gate + bob). */
const float CURVATURE = 0.02;
const float TRINITRON_CURVE = 0.0;
const float CORNER = 3.0;
const float MASK = 4.0;
const float MASK_SIZE = 1.0;
const float MASK_INTENSITY = 0.5;
const float SCANLINE_THINNESS = 0.5;
const float BEAM_DILATION = 0.5;
const float SCAN_BLUR = 0.20;
const float COLOR_BLEED = 0.0;
const float DOT_CRAWL = 0.30;
const float CRAWL_SPEED = 0.75;
const float DOT_SIZE = 2.0;
const float DOT_REACH = 1.0;
const float COLOR_TEMP = 0.0;
const float VIBRANCY = 0.10;
const float BRIGHT_BOOST = 1.1;
const float BLOOM_AMOUNT = 0.25;
const float CRT_GAMMA = 2.4;
const float CRT_OUT_GAMMA = 2.2;
const float2 texture_size = float2(320.0, 240.0);   /* DIAG: fixed, typical PS1 res */
const float2 output_size = float2(1920.0, 1080.0);   /* DIAG: fixed */
const float frame_count = 0.0;   /* DIAG: fixed, no crawl motion */
const float gateY = 240.0;   /* DIAG: fixed */
const float bob = 0.0;   /* DIAG: fixed off */

half3 CrtsMask(float2 pos, half dark) {
    if (MASK == 0.0) return half3(1.0, 1.0, 1.0);

    float x;
    half mask_line = 1.0;

    if (MASK == 1.0 || MASK == 2.0) { 
        x = frac(pos.x * 0.333333);
    } else if (MASK == 3.0) { 
        x = frac((pos.x + pos.y * 2.9999) * 0.166666);
    } else if (MASK == 4.0) { 
        float odd = step(0.5, frac(pos.x * 0.166666));
        mask_line = lerp(1.0, dark, step(0.5, frac((pos.y + odd) * 0.5)));
        x = frac(pos.x * 0.333333);
    } else if (MASK == 5.0) { 
        float2 p = floor(pos * float2(1.0, 0.5));
        x = frac((p.x + p.y * 3.0) * 0.166666);
    } else if (MASK == 6.0) { 
        float row = step(0.5, frac(pos.y * 0.5));
        x = frac((pos.x + row * 1.5) * 0.333333);
        mask_line = lerp(dark, 1.0, sin(frac(pos.y) * 3.14159265));
    } else { 
        float row = step(0.5, frac(pos.y * 0.25));
        x = frac((pos.x + row * 1.5) * 0.333333);
        mask_line = lerp(dark, 1.0, smoothstep(0.15, 0.85, sin(frac(pos.y * 0.5) * 3.14159265)));
    }

    half3 s = half3(1.0 - step(0.333333, x),
                    step(0.333333, x) - step(0.666666, x),
                    step(0.666666, x));

    half3 mask_rgb;
    if (MASK == 1.0)
        mask_rgb = lerp(half3(1.0, 1.0, 1.0), half3(dark, dark, dark), s);
    else
        mask_rgb = lerp(half3(dark, dark, dark), half3(1.0, 1.0, 1.0), s);

    return mask_rgb * mask_line;
}

float4 main(float2 coords : TEXCOORD0, uniform sampler2D tex) : COLOR
{
    // =========================================================================
    // 1. CURVATURE & VIGNETTE WARPING
    // =========================================================================
    float2 uv = coords.xy;
    /* Virtual resolution gate (Magpie v4.13, passive): the effect grid is
       gateY lines (240/480), X auto-aspect from the render target, so the
       effect stays at true CRT lines whatever the RSX scale. */
    float2 virtualSize = float2(gateY * (texture_size.x / texture_size.y), gateY);
    float2 rcpVirtualSize = 1.0 / virtualSize;
    float vin = 1.0;
    float bounds = 1.0;

    if (CURVATURE > 0.0 || CORNER > 0.0) {
        uv = uv * 2.0 - 1.0; 

        float2 warp_factor;
        warp_factor.x = CURVATURE * (1.0 - TRINITRON_CURVE);
        warp_factor.y = 0.75 * CURVATURE; 

        uv *= float2(1.0 + (uv.y * uv.y) * warp_factor.x, 1.0 + (uv.x * uv.x) * warp_factor.y);

        float corner_val = (1.0 - ((1.0 - saturate(uv.x * uv.x)) * (1.0 - saturate(uv.y * uv.y)))) * (0.998 + (0.001 * CORNER));
        // v3.4.2: AA bezel dalam physical output pixels (paritas Magpie v4.8) - ganti uniform doang, nol ALU/tap tambahan.
        vin = saturate((-corner_val) * output_size.y + output_size.y);

        uv = uv * 0.5 + 0.5;
        bounds = step(-0.0001, uv.x) * step(uv.x, 1.0001) * step(-0.0001, uv.y) * step(uv.y, 1.0001);
    }

    // =========================================================================
    // 2. DECOUPLED GAME PIXEL FETCH
    // =========================================================================
    float2 pos = uv * virtualSize;
    if (bob > 0.5) pos.y += fmod(frame_count, 2.0) * 0.5;

    float input_thin = 0.5 + (0.5 * SCANLINE_THINNESS);
    float input_mask = 1.0 - MASK_INTENSITY;

    float y0 = floor(pos.y - 0.5) + 0.5;
    float y_fract = pos.y - y0;

    pos.x += 0.5;
    float xi = floor(pos.x);
    float xf = pos.x - xi;
    xf = xf * xf * xf * (xf * (xf * 6.0 - 15.0) + 10.0);
    float x0 = xi + xf - 0.5;

    // Fast 4-Tap Blur Engine
    float blur_off = SCAN_BLUR;
    float2 p_left  = float2(x0 - blur_off, y0) * rcpVirtualSize;
    float2 p_right = float2(x0 + blur_off, y0) * rcpVirtualSize;

    half3 tA_L = tex2D(tex, p_left).rgb;
    half3 tA_R = tex2D(tex, p_right).rgb;
    half3 colA = (tA_L + tA_R) * 0.5;
    
    p_left.y  += rcpVirtualSize.y;
    p_right.y += rcpVirtualSize.y;
    
    half3 tB_L = tex2D(tex, p_left).rgb;
    half3 tB_R = tex2D(tex, p_right).rgb;
    half3 colB = (tB_L + tB_R) * 0.5;

    // Phosphor Bloom / Halation (Reuses 4 taps)
    half3 bloom_w = half3(0.299, 0.587, 0.114);
    half bloom_luma = dot((tA_L + tA_R + tB_L + tB_R) * 0.25, bloom_w);
    half bloom_glow = bloom_luma * bloom_luma * BLOOM_AMOUNT;

    half3 compA = colA;
    half3 compB = colB;

    if (COLOR_BLEED != 0.0 || DOT_CRAWL != 0.0) {
        float2 p_bleed = float2(x0 - COLOR_BLEED, y0) * rcpVirtualSize;
        half3 bleedA = tex2D(tex, p_bleed).rgb;
        p_bleed.y += rcpVirtualSize.y;
        half3 bleedB = tex2D(tex, p_bleed).rgb;

        // 1. Beam-Fused Selective Red/Blue Bleed
        half3 bleed_colA = half3(lerp(colA.r, bleedA.r, 0.85), colA.g, lerp(colA.b, bleedA.b, 0.45));
        half3 bleed_colB = half3(lerp(colB.r, bleedB.r, 0.85), colB.g, lerp(colB.b, bleedB.b, 0.45));

        // 2. Zero-Cost Edge Detection with Scalable Pixel Reach
        half3 y_w = half3(0.299, 0.587, 0.114);
        half3 diffA = abs(tA_L - tA_R);
        half3 diffB = abs(tB_L - tB_R);
        half edge_gain = 2.0 + 4.0 * DOT_REACH;
        half edge_lumaA = dot(diffA, y_w);
        half edge_lumaB = dot(diffB, y_w);
        half edgeA = saturate(edge_lumaA * edge_gain);
        half edgeB = saturate(edge_lumaB * edge_gain);

        // 3. True NTSC Chroma Energy Gate (R-Y / B-Y Quadrature Carrier Energy)
        half lumaA = dot(colA, y_w);
        half lumaB = dot(colB, y_w);
        half chromaA = max(abs(colA.r - lumaA), abs(colA.b - lumaA));
        half chromaB = max(abs(colB.r - lumaB), abs(colB.b - lumaB));

        // Symmetric Edge Chroma Transition
        half3 cdiffA = diffA - edge_lumaA;
        half3 cdiffB = diffB - edge_lumaB;
        half chroma_edgeA = max(chromaA, max(abs(cdiffA.r), abs(cdiffA.b)));
        half chroma_edgeB = max(chromaB, max(abs(cdiffB.r), abs(cdiffB.b)));

        // Pure Zero on text/monochrome, explodes on Red/Orange/Cyan/Magenta
        edgeA *= saturate(chroma_edgeA * 2.5);
        edgeB *= saturate(chroma_edgeB * 2.5);

        half magA = max(abs(bleedA.r - colA.r) * 2.0, 0.4) * edgeA;
        half magB = max(abs(bleedB.r - colB.r) * 2.0, 0.4) * edgeB;

        // 4. Beam-Fused NTSC True 3-Phase RGB Prism Dot Crawl
        float dot_x = pos.x / max(0.25, DOT_SIZE);
        half shape_x = cos(dot_x * 3.14159265);

        float phase_yA = (floor(pos.y) * 1.5707963) + (frame_count * (1.5707963 * CRAWL_SPEED));

        float sinA = sin(phase_yA);
        float cosA = cos(phase_yA);

        half3 rainbowA = half3(sinA,
                                -0.5 * sinA + 0.8660254 * cosA,
                                -0.5 * sinA - 0.8660254 * cosA);
        half3 rainbowB = half3(cosA,
                                -0.5 * cosA - 0.8660254 * sinA,
                                -0.5 * cosA + 0.8660254 * sinA);

        // Beam spot smoothing factor: blends dot crawl with horizontal beam radius
        half beam_filter = saturate(1.0 - SCAN_BLUR * 0.75);
        half crawl_amp = shape_x * (DOT_CRAWL * 1.5 * beam_filter);
        rainbowA *= crawl_amp;
        rainbowB *= crawl_amp;

        compA = bleed_colA + (magA * rainbowA);
        compB = bleed_colB + (magB * rainbowB);
    }

    // Strict vector-matching pow()
    compA = pow(max(compA, half3(0.0, 0.0, 0.0)), half3(CRT_GAMMA, CRT_GAMMA, CRT_GAMMA));
    compB = pow(max(compB, half3(0.0, 0.0, 0.0)), half3(CRT_GAMMA, CRT_GAMMA, CRT_GAMMA));
    half3 game_color = lerp(compA, compB, y_fract);

    // =========================================================================
    // 2. PHYSICAL CRT GLASS MATRIX (COHERENT SCALE)
    // =========================================================================
    float rcp_mask_scale = 1.0 / max(0.05, MASK_SIZE);
    float virtual_y = pos.y * rcp_mask_scale; 
    float vy0 = floor(virtual_y - 0.5) + 0.5;
    float v_off = virtual_y - vy0; 

    half luma = max(game_color.r, max(game_color.g, game_color.b));
    half thin = lerp(input_thin, 0.5, luma * BEAM_DILATION);

    half2 v_args = half2(v_off * thin, (-v_off) * thin + thin);
    half2 scan = cos(min(half2(0.5, 0.5), v_args) * 6.2831853) * 0.5 + 0.5;

    half3 color = game_color * (scan.x + scan.y);
    color *= vin * bounds;

    float2 ipos = coords.xy * output_size.xy;
    color *= CrtsMask(ipos * rcp_mask_scale, input_mask);

    // =========================================================================
    // 3. TONE, VIBRANCY, BOOST, OUTPUT
    // =========================================================================
    half mask_tone = (MASK == 0.0) ? 1.0 : ((MASK == 1.0) ? (0.5 + input_mask * 0.5) : input_mask);
    half midOut = 0.225 / (0.5 * mask_tone + 0.5);
    half tone_y = (midOut - 0.18) / (0.82 * midOut);
    half tone_z = (0.18 * (1.0 - midOut)) / (0.82 * midOut);

    half peak = max(1e-5, max(color.r, max(color.g, color.b)));
    color *= (1.0 / (peak * tone_y + tone_z));

    // Color Vibrancy
    half luma_final = dot(color, half3(0.2126, 0.7152, 0.0722));
    color = max(half3(0.0, 0.0, 0.0), lerp(half3(luma_final, luma_final, luma_final), color, 1.0 + VIBRANCY));

    // CRT Color Temperature (1-MAD D65 Neutral -> D93 Cool Trinitron / Warm Arcade)
    half3 temp_rgb = half3(1.0 - 0.10 * COLOR_TEMP, 
                           1.0 - 0.02 * abs(COLOR_TEMP), 
                           1.0 + 0.14 * COLOR_TEMP);
    color *= temp_rgb;

    // Strict vector-matching output gamma
    half3 final_col = pow(max(color, half3(0.0, 0.0, 0.0)), half3(1.0 / CRT_OUT_GAMMA, 1.0 / CRT_OUT_GAMMA, 1.0 / CRT_OUT_GAMMA)) * BRIGHT_BOOST;

    // Phosphor Bloom Injection Post-Gamma
    final_col = saturate(final_col + half3(bloom_glow, bloom_glow, bloom_glow));

    return float4(final_col, 1.0);
}